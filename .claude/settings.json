{
  "$comment": "Same three tiers as AGENTS.md > Permissions.",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm ci)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git commit *)",
      "Edit(src/**)",
      "Edit(docs/**)"
    ],
    "ask": [
      "Edit(tests/**)",
      "Edit(.github/**)",
      "Edit(package.json)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(git push*)",
      "Bash(gh pr *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(cat .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin --delete*)",
      "Bash(git push * :*)"
    ]
  }
}
